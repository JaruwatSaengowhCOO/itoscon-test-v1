@model itoscon.Models.LoginViewModel
@inject itoscon.Services.IStaticText T
@{
    ViewData["Title"] = T["login.title"];
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card card-body mt-4 shadow-sm">
            <h1 class="h3 mb-3 text-center">@T["login.title"]</h1>

            @if (TempData["Message"] is string msg)
            {
                <div class="alert alert-success py-2">@msg</div>
            }

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">@T["field.email"]</label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">@T["field.password"]</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">@T["login.submit"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}