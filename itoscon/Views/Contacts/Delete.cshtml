@model itoscon.Models.Contact
@inject itoscon.Services.IStaticText T
@{
    ViewData["Title"] = T["contacts.delete"];
    var isSelf = Model.Id.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h1 class="h3 mb-3">@T["contacts.delete"]</h1>

<div class="card card-body shadow-sm" style="max-width: 560px">
    <p class="mb-3">@T["contacts.deleteConfirm"] <strong>@Model.FirstName @Model.LastName</strong></p>

    @if (isSelf)
    {
        <div class="alert alert-warning">@T["err.cannotDeleteSelf"]</div>
    }

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger" disabled="@isSelf">@T["btn.confirmDelete"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["btn.cancel"]</a>
    </form>
</div>