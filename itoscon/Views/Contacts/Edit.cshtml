@model itoscon.Models.Contact
@inject itoscon.Services.IStaticText T
@{
    ViewData["Title"] = T["contacts.edit"];
    ViewData["ShowPassword"] = true;
    ViewData["PasswordOptional"] = true;
}

<h1 class="h3 mb-3">@T["contacts.edit"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm" style="max-width: 760px">
    <input type="hidden" asp-for="Id" />
    <partial name="_ContactFields" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-warning">@T["btn.saveChanges"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["btn.cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}