@model IEnumerable<itoscon.Models.Contact>
@inject itoscon.Services.IStaticText T
@{
    ViewData["Title"] = T["contacts.title"];
    var search = ViewData["Search"] as string;
    var i = 1;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@T["contacts.title"]</h1>
    <a asp-action="Create" class="btn btn-primary">@T["btn.addContact"]</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <input type="search" name="search" value="@search" class="form-control" placeholder="@T["contacts.searchPlaceholder"]" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">@T["btn.search"]</button>
    </div>
    @if (!string.IsNullOrEmpty(search))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link">@T["btn.clear"]</a>
        </div>
    }
</form>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>@T["field.fullName"]</th>
                    <th>@T["field.phone"]</th>
                    <th>@T["field.email"]</th>
                    <th>@T["field.team"]</th>
                    <th>@T["field.role"]</th>
                    <th>@T["field.manager"]</th>
                    <th class="text-end">@T["field.salary"]</th>
                    <th class="text-end">@T["table.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            @(string.IsNullOrEmpty(search) ? T["contacts.empty"] : T["contacts.noResult"])
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td class="fw-semibold">@c.FirstName @c.LastName</td>
                        <td>@c.Phone</td>
                        <td><a href="mailto:@c.Email">@c.Email</a></td>
                        <td>@(c.Team?.Name ?? "-")</td>
                        <td>@(c.Role?.Name ?? "-")</td>
                        <td>
                            @if (c.Manager is null)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <span>@c.Manager.FirstName @c.Manager.LastName</span>
                                @if (c.SubRole is not null)
                                {
                                    <small class="text-muted">(@c.SubRole.Name)</small>
                                }
                            }
                        </td>
                        <td class="text-end">@(c.Salary.HasValue ? c.Salary.Value.ToString("N2") : "-")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">@T["btn.edit"]</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">@T["btn.delete"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>