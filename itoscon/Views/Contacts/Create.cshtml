@model itoscon.Models.Contact
@inject itoscon.Services.IStaticText T
@{
    ViewData["Title"] = T["contacts.create"];
    ViewData["ShowPassword"] = true;
}

<h1 class="h3 mb-3">@T["contacts.create"]</h1>

<form asp-action="Create" method="post" class="card card-body shadow-sm" style="max-width: 760px">
    <partial name="_ContactFields" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["btn.save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["btn.cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}